          },
          "minimum_wall_mm": 1.6,
          "shrink_compensation_percent": 0.8,
          "notes": [
            "UV-resistant material; enclosure and ventilation are recommended."
          ]
        }
      ]
    },
    "config/printer/": null,
    "config/printer/large-corexy.yaml": {
      "schema_version": "1.0",
      "slug": "large-corexy",
      "name": "Large CoreXY",
      "technology": "FDM",
      "build_volume_mm": {
        "x": 300,
