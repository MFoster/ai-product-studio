    "AGENTS.md": "# AI Product Studio agent instructions\n\nRead the nearest `AGENTS.md` and applicable manifests before changing product assets.\nUse millimeters for printable geometry. Keep source, export, package, preview, and\nrelease assets separate. Do not claim slicing or physical print success without evidence.\nRun registry synchronization, asset inventory, and validation before release.\n",
    "config/": null,
    "config/material/": null,
    "config/material/material.yaml": {
      "schema_version": "1.0",
      "materials": [
        {
          "slug": "pla",
          "name": "PLA",
          "nozzle_temperature_c": {
            "minimum": 190,
            "maximum": 230
          },
          "bed_temperature_c": {
            "minimum": 45,
            "maximum": 65
          },
          "minimum_wall_mm": 1.2,
          "shrink_compensation_percent": 0.2,
          "notes": ["General-purpose rigid filament with low warping."]
        },
        {
          "slug": "petg",
          "name": "PETG",
          "nozzle_temperature_c": {
            "minimum": 220,
            "maximum": 260
          },
          "bed_temperature_c": {
            "minimum": 70,
            "maximum": 90
          },
          "minimum_wall_mm": 1.2,
          "shrink_compensation_percent": 0.4,
          "notes": [
            "Durable filament with good layer adhesion; manage stringing."
          ]
        }
      ]
    },
    "config/printer/": null,
    "config/printer/generic-fdm.yaml": {
      "schema_version": "1.0",
      "slug": "generic-fdm",
      "name": "Generic FDM Printer",
      "technology": "FDM",
      "build_volume_mm": {
        "x": {
