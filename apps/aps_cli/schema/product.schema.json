{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "material_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Group"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "Component",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "title": "Components",
      "type": "array"
    },
    "dimensions_mm": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Dimensions Mm",
      "type": "object"
    },
    "intended_use": {
      "default": "",
      "title": "Intended Use",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "output_formats": {
      "items": {
        "type": "string"
      },
      "title": "Output Formats",
      "type": "array"
    },
    "printer_profile": {
      "default": "generic-fdm",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Printer Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slug": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "slug",
    "name"
  ],
  "title": "ProductManifest",
  "type": "object"
}
