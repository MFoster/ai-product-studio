{
  "$defs": {
    "MaterialProfile": {
      "additionalProperties": false,
      "properties": {
        "bed_temperature_c": {
          "$ref": "#/$defs/TemperatureRange"
        },
        "minimum_wall_mm": {
          "exclusiveMinimum": 0,
          "title": "Minimum Wall Mm",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "nozzle_temperature_c": {
          "$ref": "#/$defs/TemperatureRange"
        },
        "shrink_compensation_percent": {
          "minimum": 0,
          "title": "Shrink Compensation Percent",
          "type": "number"
        },
        "slug": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "name",
        "nozzle_temperature_c",
        "bed_temperature_c",
        "minimum_wall_mm",
        "shrink_compensation_percent"
      ],
      "title": "MaterialProfile",
      "type": "object"
    },
    "TemperatureRange": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "integer"
        },
        "minimum": {
          "title": "Minimum",
          "type": "integer"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "TemperatureRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "materials": {
      "items": {
        "$ref": "#/$defs/MaterialProfile"
      },
      "minItems": 1,
      "title": "Materials",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "materials"
  ],
  "title": "MaterialConfiguration",
  "type": "object"
}
