{
  "additionalProperties": false,
  "description": "A record of the slicer settings a product was or will be printed with.\n\n``captured`` profiles are extracted from a real slicer project file and are\nevidence. ``stated`` profiles are hand-recorded assumptions and must never\nbe presented as evidence of how a part was actually printed.",
  "properties": {
    "brim_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Brim Type"
    },
    "build_plate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Build Plate"
    },
    "evidence": {
      "default": "captured",
      "enum": [
        "captured",
        "stated"
      ],
      "title": "Evidence",
      "type": "string"
    },
    "filament_settings_ids": {
      "items": {
        "type": "string"
      },
      "title": "Filament Settings Ids",
      "type": "array"
    },
    "filament_types": {
      "items": {
        "type": "string"
      },
      "title": "Filament Types",
      "type": "array"
    },
    "first_layer_height_mm": {
      "exclusiveMinimum": 0,
      "title": "First Layer Height Mm",
      "type": "number"
    },
    "layer_height_mm": {
      "exclusiveMinimum": 0,
      "title": "Layer Height Mm",
      "type": "number"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "nozzle_diameter_mm": {
      "exclusiveMinimum": 0,
      "title": "Nozzle Diameter Mm",
      "type": "number"
    },
    "print_settings_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Print Settings Id"
    },
    "printer_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Printer Model"
    },
    "printer_profile": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Printer Profile",
      "type": "string"
    },
    "printer_settings_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Printer Settings Id"
    },
    "product": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Product",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "settings_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Settings File"
    },
    "settings_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Settings Sha256"
    },
    "slicer": {
      "default": "Bambu Studio",
      "title": "Slicer",
      "type": "string"
    },
    "slicer_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Slicer Version"
    },
    "slug": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "source_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Sha256"
    },
    "sparse_infill_density": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sparse Infill Density"
    },
    "support_enabled": {
      "default": false,
      "title": "Support Enabled",
      "type": "boolean"
    },
    "support_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Type"
    },
    "wall_loops": {
      "minimum": 1,
      "title": "Wall Loops",
      "type": "integer"
    }
  },
  "required": [
    "slug",
    "name",
    "product",
    "printer_profile",
    "recorded_at",
    "nozzle_diameter_mm",
    "layer_height_mm",
    "first_layer_height_mm",
    "wall_loops"
  ],
  "title": "SliceProfile",
  "type": "object"
}
