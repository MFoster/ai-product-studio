{
  "$defs": {
    "AssetGroup": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/GroupLayout"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/GroupMaterial"
          },
          "minItems": 1,
          "title": "Materials",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "package": {
          "title": "Package",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/GroupPart"
          },
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "revision",
        "package",
        "materials",
        "parts"
      ],
      "title": "AssetGroup",
      "type": "object"
    },
    "AssetKind": {
      "enum": [
        "source",
        "export",
        "package",
        "preview",
        "backup",
        "document"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetRecord": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "release_eligible": {
          "default": true,
          "title": "Release Eligible",
          "type": "boolean"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "path",
        "kind",
        "format",
        "role",
        "sha256",
        "size_bytes"
      ],
      "title": "AssetRecord",
      "type": "object"
    },
    "GroupLayout": {
      "additionalProperties": false,
      "properties": {
        "margin_mm": {
          "default": 5,
          "minimum": 0,
          "title": "Margin Mm",
          "type": "number"
        },
        "orientation": {
          "const": "preserve-source",
          "default": "preserve-source",
          "title": "Orientation",
          "type": "string"
        },
        "spacing_mm": {
          "default": 6,
          "exclusiveMinimum": 0,
          "title": "Spacing Mm",
          "type": "number"
        }
      },
      "title": "GroupLayout",
      "type": "object"
    },
    "GroupMaterial": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "material": {
          "default": "pla",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Material",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "color"
      ],
      "title": "GroupMaterial",
      "type": "object"
    },
    "GroupMesh": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "material": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Material",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset",
        "material",
        "sha256"
      ],
      "title": "GroupMesh",
      "type": "object"
    },
    "GroupPart": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "meshes": {
          "items": {
            "$ref": "#/$defs/GroupMesh"
          },
          "minItems": 1,
          "title": "Meshes",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "meshes"
      ],
      "title": "GroupPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetRecord"
      },
      "title": "Assets",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/AssetGroup"
      },
      "title": "Groups",
      "type": "array"
    },
    "product": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Product",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "product",
    "generated_at"
  ],
  "title": "AssetManifest",
  "type": "object"
}
