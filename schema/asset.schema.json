{
  "$defs": {
    "AssetKind": {
      "enum": [
        "source",
        "export",
        "package",
        "preview",
        "backup",
        "document"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetRecord": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "release_eligible": {
          "default": true,
          "title": "Release Eligible",
          "type": "boolean"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "path",
        "kind",
        "format",
        "role",
        "sha256",
        "size_bytes"
      ],
      "title": "AssetRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetRecord"
      },
      "title": "Assets",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "product": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Product",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "product",
    "generated_at"
  ],
  "title": "AssetManifest",
  "type": "object"
}
