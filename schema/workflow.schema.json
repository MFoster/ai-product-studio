{
  "$defs": {
    "WorkflowEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/WorkflowStage"
        }
      },
      "required": [
        "stage",
        "at",
        "note"
      ],
      "title": "WorkflowEvent",
      "type": "object"
    },
    "WorkflowStage": {
      "enum": [
        "brief",
        "design",
        "review",
        "print-validation",
        "release"
      ],
      "title": "WorkflowStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approvals": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Approvals",
      "type": "object"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "current_stage": {
      "$ref": "#/$defs/WorkflowStage",
      "default": "brief"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/WorkflowEvent"
      },
      "title": "History",
      "type": "array"
    },
    "physical_print_status": {
      "default": "pending",
      "enum": [
        "pending",
        "passed",
        "failed"
      ],
      "title": "Physical Print Status",
      "type": "string"
    },
    "product": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Product",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "product"
  ],
  "title": "WorkflowManifest",
  "type": "object"
}
